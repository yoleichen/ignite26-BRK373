# CaseDesk AI service settings for the LOCAL Azure SQL Database container.
# Copy to .env (git-ignored) and fill in the blanks. Never commit .env.

# --- Database ---------------------------------------------------------------
SQL_SERVER=localhost
# The container's port: 1433 unless the container wizard chose another.
SQL_PORT=1433
SQL_DATABASE=CaseDesk
# sql = SQL authentication (local container), entra = Microsoft Entra ID (Azure)
SQL_AUTH=sql
SQL_USER=sa
# Put your container password between the single quotes. Without them, a # would start a comment.
SQL_PASSWORD=''
# The local container uses a self-signed certificate. Allowed for localhost only.
SQL_TRUST_SERVER_CERTIFICATE=true

# --- AI provider: azure or ollama --------------------------------------------
AI_PROVIDER=azure

# Azure OpenAI. Sign in with `az login`; the service authenticates with Microsoft Entra ID.
# Your identity needs the "Cognitive Services OpenAI User" role on the resource.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini

# Ollama (optional local path). Switching providers means re-running `npm run embed`.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# --- Retrieval ----------------------------------------------------------------
RAG_TOP_K=3
# Cosine distance cut-off (smaller is closer). `npm run calibrate` measures it for your model and saves it here.
RAG_MAX_DISTANCE=0.5

PORT=8000
